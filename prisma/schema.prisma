generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PLACED
  PAYMENT_CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Order {
  id                 String      @id @default(cuid())
  orderNumber        String      @unique
  // Clerk user id (string, e.g. "user_xxx"). Null for guest checkout.
  userId             String?
  customerName       String
  email              String?
  phone              String
  address            String
  city               String
  state              String
  notes              String?
  paymentMethodLabel String
  paymentReference   String?
  subtotal           Int
  delivery           Int
  total              Int
  status             OrderStatus @default(PLACED)
  items              OrderItem[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  productSlug String
  productName String
  unitPrice   Int
  quantity    Int
  // Informational size/color picked on the product page (see Product.sizes
  // / Product.colors) — carried through from the cart line so staff can see
  // what was actually ordered.
  size        String?
  color       String?

  @@index([orderId])
}

// Storefront categories, migrated 2026-09-02 from the static `categories`
// array in src/lib/placeholder-data.ts so staff can add/rename/remove a
// collection without a code deploy (see /admin/categories). Product.categorySlug
// points at Category.slug, but deliberately without a real FK relation: the
// product catalog was migrated first and already holds free-text slugs, and
// the delete route enforces the same rule a FK would (a category holding
// products can't be deleted) with a far better error message.
model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  // One of the IconKey values in src/lib/product-types.ts — picks the stock
  // illustration/photo used when no `image` is set.
  icon        String
  image       String?
  // Umbrella categories: /category/[slug] also lists products from every
  // slug named here, on top of its own. Replaces the hard-coded
  // accessoryCategorySlugs / beautyCategorySlugs constants. The category's
  // own slug is always included implicitly, so this holds only the extras.
  groupSlugs  String[] @default([])
  // Which header dropdown this collection appears under: "collections",
  // "accessories", or null for none. The two menus are alphabetical, so
  // sortOrder doesn't apply there — it orders the homepage grid instead.
  // Managed from /admin/categories so a new collection can be put on the
  // menu without a deploy.
  navGroup    String?
  // Display order for the homepage grid, footer and pickers.
  sortOrder   Int      @default(0)
  // False for pure umbrellas like Accessories: it has no products of its
  // own, so it must not be offered as a choice when editing a product.
  assignable  Boolean  @default(true)
  // Whether it gets a tile in the homepage "Shop by Collection" grid.
  showOnHome  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@index([navGroup])
}

// Full product catalog, migrated 2026-08-07 from the static
// src/lib/placeholder-data.ts array so admin can edit price/stock/promo
// state live. categorySlug references Category.slug (migrated to the DB in
// turn on 2026-09-02, see the Category model above).
// fragranceNotes is a nested {top,heart,base} object, relevant
// to perfumes only, stored as Json since it's a small fixed shape.
model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  category       String
  categorySlug   String
  price          Int
  compareAtPrice Int?
  badge          String?
  icon           String
  image          String? // primary/cover photo — used everywhere a single thumbnail is needed (cards, admin list)
  images         String[] @default([]) // full gallery for the product detail page, up to 10; image is included as the first entry when present
  description    String
  benefits       String[]
  directions     String
  ingredients    String?
  fragranceNotes Json?
  // Informational option tags (e.g. sizes: ["40","41","42"], colors:
  // ["Black","Brown"]) — customer picks one of each on the product page,
  // it's carried through cart/checkout as a note on the line item. Not a
  // real per-variant inventory/pricing system (each combination doesn't
  // have its own stock count) — this is the lightweight version for
  // products where the option matters but fine-grained stock-per-size
  // isn't being tracked yet.
  sizes          String[] @default([])
  colors         String[] @default([])
  // Optional per-size price override, e.g. {"25ml": 45000, "100ml": 120000}
  // — keyed by the exact strings in `sizes`. A size with no entry here (or
  // when this whole field is null) falls back to the base `price` above,
  // so this stays backward compatible with products where size doesn't
  // change price (shoes, etc).
  sizePricing    Json?
  rating         Float
  reviewCount    Int
  inStock        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([categorySlug])
}

// Live chat (2026-08-15): polling-based, not a raw persistent socket
// connection. Customer/admin widgets re-check the DB every few seconds
// via /api/chat and /api/admin/chat. Deliberately avoids a third-party
// realtime service (Pusher/Ably/etc.) so this stays on the existing free
// Neon+Vercel stack with no new account, at the cost of a few seconds'
// delivery lag instead of true instant push. Acceptable for a small
// single-store support inbox. Guest chat works the same way guest
// checkout/cart/wishlist do: no account needed, the conversation id itself
// is persisted client-side (localStorage) so a guest returns to the same
// thread across visits (see src/components/chat/chat-widget.tsx).
enum ChatStatus {
  OPEN
  CLOSED
}

enum ChatSender {
  CUSTOMER
  STAFF
}

model ChatConversation {
  id            String        @id @default(cuid())
  // Clerk user id if signed in. Null for guest chat, mirrors Order.userId.
  userId        String?
  customerName  String?
  customerEmail String?
  status        ChatStatus    @default(OPEN)
  lastMessageAt DateTime      @default(now())
  messages      ChatMessage[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([status, lastMessageAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         ChatSender
  senderName     String?
  body           String
  // Drives the admin sidebar's unread badge (readByStaff) and the
  // customer-side unread dot on the closed chat bubble (readByCustomer).
  readByStaff    Boolean          @default(false)
  readByCustomer Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@index([conversationId])
}

// Abandoned-cart email tracking (2026-08-07): a lightweight snapshot taken
// when a customer enters their email on the checkout form, before they've
// necessarily completed payment. If no matching Order shows up within an
// hour, the cron job at /api/cron/abandoned-cart sends one reminder.
// Genuinely "cart" tracking (pre-checkout) isn't possible since the cart
// itself is client-side-only localStorage with no email attached — this is
// the earliest point in the funnel where we have both.
model AbandonedCheckout {
  id           String   @id @default(cuid())
  email        String
  customerName String?
  items        Json // snapshot: [{ slug, name, price, quantity }]
  subtotal     Int
  reminded     Boolean  @default(false)
  converted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([reminded, converted])
}

enum ContentDraftType {
  SOCIAL_POST
  PROMO_EMAIL
  BLOG_IDEA
}

enum ContentDraftStatus {
  DRAFT
  APPROVED
  DISMISSED
}

// AI-drafted marketing copy (see src/lib/ai-agents.ts), generated weekly
// from the real catalog (best sellers, new arrivals) and reviewed by staff
// in /admin/content before anything goes out. Nothing here is ever posted
// or sent automatically. There's no Instagram/Facebook/Resend-campaign
// integration behind this, on purpose. This is a drafting desk, not a
// publisher: approving a draft marks it reviewed so staff know it's ready
// to copy out by hand, it doesn't trigger any outbound action.
model ContentDraft {
  id        String             @id @default(cuid())
  type      ContentDraftType
  title     String
  body      String
  status    ContentDraftStatus @default(DRAFT)
  createdAt DateTime           @default(now())

  @@index([status])
}
