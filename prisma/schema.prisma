generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PLACED
  PAYMENT_CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Order {
  id                 String      @id @default(cuid())
  orderNumber        String      @unique
  // Clerk user id (string, e.g. "user_xxx"). Null for guest checkout.
  userId             String?
  customerName       String
  email              String?
  phone              String
  address            String
  city               String
  state              String
  notes              String?
  paymentMethodLabel String
  paymentReference   String?
  subtotal           Int
  delivery           Int
  total              Int
  status             OrderStatus @default(PLACED)
  items              OrderItem[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  productSlug String
  productName String
  unitPrice   Int
  quantity    Int
  // Informational size/color picked on the product page (see Product.sizes
  // / Product.colors) — carried through from the cart line so staff can see
  // what was actually ordered.
  size        String?
  color       String?

  @@index([orderId])
}

// Full product catalog, migrated 2026-08-07 from the static
// src/lib/placeholder-data.ts array so admin can edit price/stock/promo
// state live. categorySlug references the still-static category list in
// placeholder-data.ts (categories aren't part of this migration — just
// products). fragranceNotes is a nested {top,heart,base} object, relevant
// to perfumes only, stored as Json since it's a small fixed shape.
model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  category       String
  categorySlug   String
  price          Int
  compareAtPrice Int?
  badge          String?
  icon           String
  image          String? // primary/cover photo — used everywhere a single thumbnail is needed (cards, admin list)
  images         String[] @default([]) // full gallery for the product detail page, up to 10; image is included as the first entry when present
  description    String
  benefits       String[]
  directions     String
  ingredients    String?
  fragranceNotes Json?
  // Informational option tags (e.g. sizes: ["40","41","42"], colors:
  // ["Black","Brown"]) — customer picks one of each on the product page,
  // it's carried through cart/checkout as a note on the line item. Not a
  // real per-variant inventory/pricing system (each combination doesn't
  // have its own stock count or price) — that's a bigger feature; this is
  // the lightweight version for products where the option matters but
  // fine-grained stock-per-size isn't being tracked yet.
  sizes          String[] @default([])
  colors         String[] @default([])
  rating         Float
  reviewCount    Int
  inStock        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([categorySlug])
}

// Abandoned-cart email tracking (2026-08-07): a lightweight snapshot taken
// when a customer enters their email on the checkout form, before they've
// necessarily completed payment. If no matching Order shows up within an
// hour, the cron job at /api/cron/abandoned-cart sends one reminder.
// Genuinely "cart" tracking (pre-checkout) isn't possible since the cart
// itself is client-side-only localStorage with no email attached — this is
// the earliest point in the funnel where we have both.
model AbandonedCheckout {
  id           String   @id @default(cuid())
  email        String
  customerName String?
  items        Json // snapshot: [{ slug, name, price, quantity }]
  subtotal     Int
  reminded     Boolean  @default(false)
  converted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([reminded, converted])
}
