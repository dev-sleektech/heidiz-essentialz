# Copy this file to .env.local and fill in real values.
# Get Paystack keys at https://dashboard.paystack.com/#/settings/developer
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Get Monnify keys at https://developers.monnify.com (sandbox test keys are
# free, no business verification required). Switch MONNIFY_BASE_URL to
# https://api.monnify.com with live keys when ready to accept real payments.
NEXT_PUBLIC_MONNIFY_API_KEY=MK_TEST_XXXXXXXXXX
MONNIFY_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_MONNIFY_CONTRACT_CODE=xxxxxxxxxx
NEXT_PUBLIC_MONNIFY_TEST_MODE=true
MONNIFY_BASE_URL=https://sandbox.monnify.com

# Get a Resend key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=HEIDIZ Essentialz <onboarding@resend.dev>

# Get Clerk keys at https://dashboard.clerk.com (Configure -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Neon Postgres connection string (order persistence via Prisma).
# Get one free at https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Comma-separated list of emails allowed into the admin dashboard at /admin.
# Must match the email the person signs in with.
ADMIN_EMAILS=owner@example.com

# Get Cloudinary keys at https://cloudinary.com (free tier, no card
# required) — used for real product-photo upload from /admin.
CLOUDINARY_CLOUD_NAME=xxxxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
